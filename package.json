{
  "name": "moodle-ai-reviewer",
  "version": "0.3.0",
  "type": "module",
  "scripts": {
    "dev": "bun run src/main.ts",
    "typecheck": "tsc --noEmit",
    "build:web": "cd src/web && bun run build",
    "build:windows": "bun build ./src/main.ts --compile --target=bun-windows-x64 --outfile=moodle-reviewer.exe",
    "build:macos": "bun run scripts/build-macos.ts",
    "build:macos:arm64": "bun build ./src/main.ts --compile --target=bun-darwin-arm64 --outfile=moodle-reviewer-macos-arm64",
    "build:macos:x64": "bun build ./src/main.ts --compile --target=bun-darwin-x64 --outfile=moodle-reviewer-macos-x64",
    "reset:data": "bun run scripts/reset-data.ts"
  },
  "dependencies": {
    "@hono/node-server": "latest",
    "hono": "latest",
    "puppeteer-core": "latest",
    "pdf-parse": "latest",
    "nanoid": "latest",
    "zod": "latest"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "typescript": "latest"
  }
}
